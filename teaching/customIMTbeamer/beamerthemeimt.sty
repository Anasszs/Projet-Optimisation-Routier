\if@dosectionpages
\newcommand{\insertsectionHEAD}{%
  \expandafter\insertsectionHEADaux\insertsectionhead}
  \newcommand{\insertsectionHEADaux}[3]{#3}

\AtBeginSection[]
{
  \begingroup
  \usebackgroundtemplate{
    	\begin{tikzpicture}[very thick,top color=white,bottom color=gray]
    		\fill[white] (0,0) rectangle (\paperwidth,\paperheight);
        \fill[imtGrey] (0,\paperheight) -- (.7\paperheight,\paperheight) -- (0,.3\paperheight) -- cycle;
    	\fill[imtBlue] (0,0) -- (.45\paperheight,0) -- (0,.45\paperheight) -- cycle;
        \fill[color=imtRed] (.925\paperwidth,.5\paperheight) -- (\paperwidth,\paperheight/2+.15\paperheight) -- (\paperwidth,\paperheight/2-.15\paperheight) -- cycle;
        \node[xshift=-10em] (A) at (.8\paperwidth,.5\paperheight) {
        \begin{minipage}{.6\paperwidth}
        \raggedleft\usebeamerfont{title}\usebeamercolor[fg]{title page}\insertsectionHEAD
        \end{minipage}
        };
    	\end{tikzpicture}
    }
  \setbeamercolor{background canvas}{parent=palette tertiary}
  \begin{frame}[plain]
    \hfill\usebeamerfont{section title}
  \end{frame}
  \endgroup
  \usebackgroundtemplate{}
}
\else
\fi

