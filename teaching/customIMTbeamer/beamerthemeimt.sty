%-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
%	TITLE PAGE
%-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=

\def\maketitle{\ifbeamer@inframe\titlepage\else\frame{\titlepage}\fi}

\def\titlepage{\usebeamertemplate{title page}}
\setbeamertemplate{title page}
{    
    \begin{tikzpicture}[overlay,top color=white,bottom color=gray]
        \node[inner sep=0,yshift=-1em] (A) at (.325\paperwidth,-0.035\paperheight) {
         \begin{minipage}{.65\paperwidth}
    	{\raggedright\linespread{1.0}\usebeamerfont{title}\usebeamercolor[fg]{title page}{\inserttitle}\par}\vspace{-1.em}
        
        {\raggedright\usebeamerfont{subtitle}\usebeamercolor[fg]{title page}{\insertsubtitle}\par}%
         \end{minipage}
    	};

    \draw node [inner sep=0, below of=A, yshift=-2em, xshift=-12.5em] (B) {
    	\begin{minipage}{.15\paperwidth}
			{\usebeamerfont{date}\usebeamercolor[fg]{date}\footnotesize{\textbf{\insertdate}}\par}
    	\end{minipage}
    };     

    \draw node [inner sep=0, below of=A, yshift=-2em, xshift=6em] (C) {
    	\begin{minipage}{.41\paperwidth}
   		\ifx\insertinstitut\@empty%
    		\else%
    		{\raggedleft\usebeamerfont{author}\usebeamercolor[fg]{author}\textbf{\footnotesize \insertauthor}\par}%
    		\fi%
    	\end{minipage}
    };     
        \draw node [inner sep=0, below of=C, xshift=-3.5em, yshift=-4em] (E) {
    	\begin{minipage}{.5\paperwidth}
   		\ifx\insertinstitut\@empty%
    		\else%
    		{\raggedright\usebeamerfont{institute}\usebeamercolor[fg]{title page}\insertinstitute\par}%
    		\fi%
    	\end{minipage}
    };     
    \end{tikzpicture}
}

