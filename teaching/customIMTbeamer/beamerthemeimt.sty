\newcommand{\addfootline}{
 %==== REPOSITIONING FOOTLINE
	\setbeamertemplate{footline}{
    \begin{tikzpicture}[very thick,top color=white,bottom color=gray,overlay, remember picture]
        \draw[imtRed, thin] (0, .11\paperheight) -- (.95\paperwidth, .11\paperheight) -- (.88\paperwidth,0);
        \draw[imtBlue, thin] (.91\paperwidth, .02\paperheight) -- (.988\paperwidth, 0.02\paperheight) -- (.988\paperwidth, .15\paperheight) -- cycle;
        \node (fnum) at (.965\paperwidth, .06\paperheight){\usebeamerfont{page number in head/foot}\insertframenumber};
        \node (logos) at (.3\paperheight, .055\paperheight) {\includegraphics[height=0.07\paperheight]{customIMTbeamer/logos/logo_imt_ales.png}\qquad\includegraphics[height=0.07\paperheight]{customIMTbeamer/logos/Logo2IA.png}};
        \node[xshift=-19em, yshift=-.25em] (footlinetext) at (fnum.west) {
        \begin{minipage}{.3\paperwidth}
        \raggedleft\usebeamerfont{page number in head/foot}\insertshorttitle ~/~ \insertdate
        \end{minipage}
        };
    \end{tikzpicture}
}
}
\newcommand{\removefootline}{\setbeamertemplate{footline}{}}

