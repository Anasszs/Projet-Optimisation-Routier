                cell{odd}{even} = {bg=imtRed!20, font=\footnotesize},
                cell{1}{odd}={bg=imtBlue, fg=white, font=\small\bfseries},
                cell{1}{even}={bg=imtRed, fg=white, font=\small\bfseries},
            }%
        }%
        {%
        \end{tblr}%
        }%
