{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STTRPSD course solution version 1",
  "description": "The scorer verifies customer coverage, satellite membership, all capacities and main-route structure against the selected instance. Truck-only routes implicitly begin and end at their named satellite. It recomputes all distances and accepts no declared objective field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance", "main_route", "truck_routes"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "instance": {"type": "string", "minLength": 1},
    "main_route": {"type": "array", "minItems": 3, "items": {"type": "integer"}},
    "truck_routes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["satellite", "customers"],
        "properties": {
          "satellite": {"type": "integer"},
          "customers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
