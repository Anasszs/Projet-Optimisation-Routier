{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STTRPSD course instance version 1",
  "description": "Structural schema. The Python loader additionally checks unique IDs, capacity feasibility, finite values, and explicit-matrix dimensions, symmetry and node mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "depot", "satellites", "customers", "truck_capacity", "trailer_capacity", "distance"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "name": {"type": "string", "minLength": 1},
    "depot": {"$ref": "#/$defs/location"},
    "satellites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/location"}},
    "customers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/customer"}},
    "truck_capacity": {"type": "number", "exclusiveMinimum": 0},
    "trailer_capacity": {"type": "number", "minimum": 0},
    "distance": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"enum": ["euclidean", "rounded_euclidean"]}}},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "node_order", "matrix"],
          "properties": {
            "type": {"const": "explicit"},
            "node_order": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "integer"}},
            "matrix": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 3, "items": {"type": "number", "minimum": 0}}}
          }
        }
      ]
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "x", "y"],
      "properties": {"id": {"type": "integer"}, "x": {"type": "number"}, "y": {"type": "number"}}
    },
    "customer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "x", "y", "demand"],
      "properties": {"id": {"type": "integer"}, "x": {"type": "number"}, "y": {"type": "number"}, "demand": {"type": "number", "exclusiveMinimum": 0}}
    }
  }
}
